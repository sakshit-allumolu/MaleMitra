# Copy to .env (never commit .env). Real environment variables take precedence.

# ── Mode ─────────────────────────────────────────────────────────────────────
# true  = demo: seeds demo users/incidents (password demo123), shows password-reset tokens in the API
#         response, allows public admin/responder sign-up with ADMIN_SIGNUP_CODE, allows legacy tokens.
# false = production: refuses to start unless JWT_SECRET / CORS_ORIGINS are safe (see below).
DEMO_MODE=true
# Demo mode returns the password-reset token in the API response. Set false on a public URL.
EXPOSE_RESET_TOKEN=true

# ── Required when DEMO_MODE=false ────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated browser origins allowed to call the API cross-origin (empty = same origin only).
CORS_ORIGINS=
# First administrator, created on startup if no account with this email exists. Change/remove after login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, one host): just DATABASE_PATH.
DATABASE_PATH=backend/app/data/malemitra.db
# PostgreSQL (several hosts / HA): set DATABASE_URL and it is used instead of DATABASE_PATH
# (which then only locates the uploads folder). docker compose sets this for you.
# Move existing SQLite data over once: python -m backend.scripts.migrate_sqlite_to_postgres --help
DATABASE_URL=
DATABASE_SCHEMA=
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_TIMEOUT_SECONDS=15
# Used by docker compose for the bundled postgres service. Change outside local development.
POSTGRES_PASSWORD=malemitra-dev

# Worker processes per container. State (closures, hazards, rate limits, ripple result) is shared via the DB.
WEB_CONCURRENCY=2

# ── Rate limits (per client IP / per account; stored in the DB, shared by all workers) ─────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_REPORTS_PER_HOUR=30
RATE_LIMIT_SIMULATIONS_PER_MIN=10
RATE_LIMIT_UPLOADS_PER_HOUR=20

# Photo uploads (JPEG/PNG; EXIF/GPS stripped). Default: an "uploads" folder next to the database.
UPLOAD_DIR=
MAX_UPLOAD_BYTES=5242880

# ── Notifications (email / SMS) ──────────────────────────────────────────────
# Email: set SMTP_HOST. SMS: set NOTIFY_WEBHOOK_URL to a relay you operate in front of your SMS gateway
# (Twilio, MSG91, ...); we POST JSON signed with HMAC-SHA256 in the X-MaleMitra-Signature header.
# With neither set, messages are only logged (and password-reset bodies are redacted from the log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MaleMitra <no-reply@example.org>
SMTP_STARTTLS=true
SMTP_SSL=false
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_LOG_ONLY=false
NOTIFY_MAX_ATTEMPTS=6

# ── watsonx Orchestrate agent (optional) ─────────────────────────────────────
AGENT_TOOL_API_KEY=
PUBLIC_BASE_URL=http://localhost:8000
ORCHESTRATE_API_KEY=
ORCHESTRATE_INSTANCE_URL=
ORCHESTRATE_AGENT_ID=

# ── TomTom live traffic (optional) ───────────────────────────────────────────
# One key enables both features. Without it they stay off and the app uses synthetic flows and the
# typical-hours traffic model. The free tier is ~2500 requests/day in total, so the two budgets below
# must add up to less than that.
TOMTOM_API_KEY=
# 1) Flow polling: real speeds on monitored roads feed congestion costs in risk-aware routing.
LIVE_TRAFFIC_DAILY_REQUEST_BUDGET=1500
# 2) Routing API: live-traffic ETAs for /routes/compare (rolling 24h cap shared by all workers).
TOMTOM_ROUTING_ENABLED=true
TOMTOM_ROUTING_DAILY_BUDGET=800
TOMTOM_ROUTING_TIMEOUT_SECONDS=5
TOMTOM_ROUTING_CACHE_TTL_SECONDS=120

# ── Reverse proxy / load balancer ────────────────────────────────────────────
# uvicorn trusts X-Forwarded-For only from these addresses. Set to your proxy's IP (or "*" if the
# app port is reachable ONLY through the proxy). Without it, all users share the proxy's IP in rate limits.
FORWARDED_ALLOW_IPS=127.0.0.1
# HSTS is sent on https responses by default when DEMO_MODE=false. Set HSTS_ENABLED=false to disable.

# ── Account protection ───────────────────────────────────────────────────────
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# ── Road-following route geometry (OSRM) ─────────────────────────────────────
# docker compose runs a self-hosted OSRM (service "osrm") and points the app at http://osrm:5000/route/v1/driving.
# Running the API outside Docker: start it with `docker compose up -d osrm` and use http://localhost:5000/...
# The public demo server below is for demos only (no SLA). Failures fall back to graph geometry.
OSRM_ENABLED=true
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
# Map data used by the compose osrm-download service (cropped to the bounding box min_lon,min_lat,max_lon,max_lat).
# "simple" needs little RAM; roads crossing the box edge are cut there.
OSRM_PBF_URL=https://download.openstreetmap.fr/extracts/asia/india/karnataka.osm.pbf
OSRM_BBOX=77.40,12.80,77.80,13.15
OSRM_BBOX_STRATEGY=simple
# TLS is verified unless DEMO_MODE=true; set OSRM_VERIFY_TLS explicitly to override.
OSRM_TIMEOUT_SECONDS=4
OSRM_CACHE_TTL_SECONDS=600
